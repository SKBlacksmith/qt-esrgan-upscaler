# Maintainer: SKBlacksmith (CrossNetwork)
pkgname=qt-esrgan-upscaler
pkgver=0.2.0
pkgrel=1
pkgdesc="Native Qt 6 front-end for batch image upscaling with Real-ESRGAN (ncnn/Vulkan)"
arch=('any')
url="https://github.com/SKBlacksmith/qt-esrgan-upscaler"
license=('GPL-3.0-or-later')
# The upscaler itself comes from the AUR: realesrgan-ncnn-vulkan-bin provides
# realesrgan-ncnn-vulkan. The public source archive is generated locally from
# the tagged checkout by make-source.sh; fetching the repository needs no key.
depends=('python' 'pyside6' 'python-pillow' 'realesrgan-ncnn-vulkan')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("$pkgname-$pkgver.tar.gz")
# The archive is rebuilt from this repository on every update; run `makepkg -g`
# if you prefer pinned checksums over SKIP.
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/qt-esrgan-upscaler.desktop \
    "$pkgdir/usr/share/applications/qt-esrgan-upscaler.desktop"
  install -Dm644 packaging/qt-esrgan-upscaler.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/qt-esrgan-upscaler.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
